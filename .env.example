# Copy to .env (never commit .env)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DECISION_DATE=2025-03-31
# SEC requires a contact in the User-Agent, e.g. "MAID research you@example.com"
SEC_USER_AGENT=
